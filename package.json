{
  "name": "claudiodearaujo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "content:build": "node tools/content/build-content.mjs",
    "prebuild": "npm run content:build",
    "postbuild": "node tools/launch/emit-404.mjs && node tools/launch/csp-hashes.mjs",
    "csp:update": "node tools/launch/csp-hashes.mjs --update",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:unit": "ng test --watch=false",
    "test:tools": "vitest run --config vitest.tools.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,scss,md}\" \"e2e/**/*.ts\" \"tools/**/*.mjs\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,md}\" \"e2e/**/*.ts\" \"tools/**/*.mjs\" \"*.{ts,json}\"",
    "validate": "npm run content:build && npm run format:check && npm run lint && npm run typecheck && npm run test:tools && npm run test:unit && npm run build",
    "validate:full": "npm run validate && npm run test:e2e",
    "prestart": "npm run content:build",
    "postinstall": "npm run content:build",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "validate:deployment": "npm run content:build && node tools/launch/validate-deployment.mjs",
    "validate:launch:live": "npm run validate:deployment && npm run test:e2e:live"
  },
  "private": true,
  "packageManager": "npm@11.15.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.0.0",
    "marked": "^18.0.13",
    "prettier": "^3.8.1",
    "sanitize-html": "^2.17.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
